# AI Agent Configuration
# ======================
# Copy this file to .env and fill in your values

# Google API Key (from aistudio.google.com)
GOOGLE_API_KEY=AIzaSy...

# Google Sheet URL (for Outlook sync)
SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# Service Account File Path
SERVICE_ACCOUNT_FILE=service_account.json

# Edge Browser Configuration (Windows)
OUTLOOK_USERNAME=YourUsername
EDGE_PATH=C:\Users\YourUsername\AppData\Local\Microsoft\Edge\User Data
EDGE_EXE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
EDGE_PROFILE=Default

# Sync Interval (seconds)
SYNC_INTERVAL=900

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=true

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Get your user ID from @userinfobot on Telegram
TELEGRAM_USER_ID=your-user-id-here
TELEGRAM_USER_NAME=YourName
